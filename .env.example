# Host-run API / psql only. Do not set host `db` here unless the process is
# inside Compose — that name does not resolve on the laptop and surfaces as
# [Errno -2] Name or service not known on Corpus / Ingest. Compose already
# sets DATABASE_URL=@db on the api service.
# DATABASE_URL=postgresql://citebench:citebench@127.0.0.1:5432/citebench

# Groq chat (config chat_model). Required for POST /generate / Playground.
# Embeddings are local nomic-embed-text-v1.5 (Groq no longer hosts that model).
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional override of config.yaml chat_model (default openai/gpt-oss-20b).
# llama-3.1-8b-instant 404s on developer keys after 2026-08-16.
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Local nomic-embed-text-v1.5 ONNX cache (first ingest downloads ~0.5 GB)
# NOMIC_CACHE_DIR=/tmp/nomic-embed
# CITEBENCH_ALLOW_WIPE=1
# CITEBENCH_USER_SOURCE_MAX_BYTES=67108864
# Skip nomic + FlashRank preload at API startup (pytest sets this automatically)
# CITEBENCH_SKIP_MODEL_WARMUP=1
# EMBED_BACKEND=local  # groq_then_local restores the historical Groq embed probe

# Langfuse (C5). Cloud: https://cloud.langfuse.com (or us.cloud.langfuse.com).
# Self-host: docker compose --profile langfuse up, then
#   LANGFUSE_HOST=http://langfuse:3000
#   LANGFUSE_PUBLIC_KEY=pk-lf-citebench-dev
#   LANGFUSE_SECRET_KEY=sk-lf-citebench-dev
# If unset, host is down, or keys are rejected, emit_trace keeps a local store.
# Leave these empty unless you run `docker compose --profile langfuse` or have
# real cloud keys. Demo keys without the Langfuse service only produce SDK noise.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# TRACE_STORE_DIR=/tmp/citebench-traces
# Last RAGAS CI artifact (Evals tab). Default: evals/results
# EVAL_STORE_DIR=evals/results
# C8 redteam split (Evals tab + python -m citebench.eval.redteam)
# REDTEAM_JSONL=evals/redteam.jsonl
# Public demo: comma-separated browser origins for the API (Playground + Evals stay public)
# Host port for the TanStack Start UI (container still listens on 3000).
# Gotenberg also defaults to :3000. If the browser says "Gotenberg has no UI",
# you hit that API, not Citebench — stop it or set WEB_PORT=3100.
# WEB_PORT=3000
# Server-only FastAPI origin used by Nitro SSR loaders / /api proxies.
# Compose sets API_URL=http://api:8000. Local Vite defaults to 127.0.0.1:8000.
# API_URL=http://127.0.0.1:8000
# Public FastAPI origin used by the browser (corpus/traces/evals + ask/ingest).
# Replaces unused NEXT_PUBLIC_API_URL.
# VITE_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000,https://your-demo.example
# Optional single demo password for the Caddy overlay in infra/deploy (user citebench)
# DEMO_PASSWORD=citebench
# C9 MCP (python -m citebench.mcp) talks to the Compose API
# CITEBENCH_API_URL=http://localhost:8000
